{
  "cleanUrls": false,
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/painel-de-led", "destination": "/painel-de-led.html" },
    { "source": "/home", "destination": "/index.html" }
  ],
  "redirects": [
    { "source": "/totem-de-led.html", "destination": "/painel-de-led", "permanent": true },
    { "source": "/totem-de-led", "destination": "/painel-de-led", "permanent": true },
    { "source": "/painel-de-led.html", "destination": "/painel-de-led", "permanent": true }
  ],
  "headers": [
    {
      "source": "/loja/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/comprar/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/loja/catalogo.json",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
